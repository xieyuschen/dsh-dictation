{
  "name": "@xieyuschen/dsh-dictation",
  "version": "0.1.0",
  "type": "module",
  "description": "Model-independent, durable voice dictation for DeepSeek Harness",
  "repository": { "type": "git", "url": "https://github.com/xieyuschen/dsh-dictation.git" },
  "bugs": { "url": "https://github.com/xieyuschen/dsh-dictation/issues" },
  "homepage": "https://github.com/xieyuschen/dsh-dictation#readme",
  "license": "MIT",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "provider.js", "client.js", "cordis.patch.yml", "locale/en.json", "locale/zh.json", "icon.svg", "LICENSE", "README.md", "SECURITY.md", "CONTRIBUTING.md", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node --test dictation-*.test.js provider.test.js",
    "test:browser": "node --test dictation-browser.test.mjs",
    "check:release": "npm test && npm run test:browser && npm run build && node scripts/check-public.mjs",
    "prepack": "npm run build && node scripts/check-public.mjs"
  },
  "engines": { "dsh": "0.2.2-rc.1", "node": ">=22" },
  "overrides": { "zod": "4.6.6" },
  "dependencies": { "@deepseek-ai/schemastery": "3.19.0" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-experimental-api-speech-to-text": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "playwright": "1.65.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager"],
      "external": []
    }
  }
}
